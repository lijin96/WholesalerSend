<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/RelativeLayout1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="Deprecated,HardcodedText,ObsoleteLayoutParam,ContentDescription" >

    <include
        android:id="@+id/include1"
        layout="@layout/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_x="@dimen/scaled_o_dp_0"
        android:layout_y="@dimen/scaled_o_dp_neg1" />


    <include
        android:id="@+id/include2"
        layout="@layout/titlebotom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true" />

    <TextView
        android:id="@+id/tv_set_brandcode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_below="@+id/include1"
        android:textSize="@dimen/scaled_t_dp_22"
        android:text="设置品牌代号"></TextView>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">

        <TextView
            android:id="@+id/tv_content_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/scaled_h_dp_10"
            android:gravity="center"
            android:text="@string/aboutcontenttitle"
            android:textSize="@dimen/scaled_t_dp_22"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/listrowmenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_content_title"
            android:layout_centerHorizontal="true"
            android:layout_marginLeft="@dimen/scaled_w_dp_20"
            android:layout_marginTop="@dimen/scaled_h_dp_12"
            android:text="@string/aboutcontent"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/txt_pur_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/listrowmenu"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/scaled_h_dp_70"
            android:gravity="center_horizontal"
            android:text="@string/Copyright"
            android:textSize="@dimen/scaled_t_dp_16" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_pur_1"
            android:layout_centerHorizontal="true">

            <TextView
                android:id="@+id/tv_tel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="客服电话：0755-29822832"
                android:textSize="@dimen/scaled_t_dp_14" />

            <TextView
                android:id="@+id/tv_qq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/scaled_w_dp_20"
                android:layout_toRightOf="@id/tv_tel"
                android:text="客服QQ：3493151409"
                android:textSize="@dimen/scaled_t_dp_14" />
        </RelativeLayout>
    </RelativeLayout>

    <TextView
        android:id="@+id/tv_changeaddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_marginRight="@dimen/scaled_w_dp_20"
        android:layout_marginBottom="@dimen/scaled_h_dp_20"
        android:layout_above="@+id/include2"
        android:text="测试地址"
        android:textColor="@color/gray"></TextView>

</RelativeLayout>