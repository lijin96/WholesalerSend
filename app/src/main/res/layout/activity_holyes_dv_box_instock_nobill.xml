<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText,dpUsage,InefficientWeight,UselessLeaf" >

    <LinearLayout
        android:id="@+id/linear_above"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black"
            android:gravity="left"
            android:paddingLeft="@dimen/scaled_w_dp_10"
            android:text="【无单盒标入库】"
            android:textColor="@color/white"
            android:textSize="@dimen/scaled_t_dp_30" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@drawable/titlebar_back"
            android:orientation="horizontal" >
            <RelativeLayout
                android:id="@+id/relayout_left"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingBottom="@dimen/scaled_h_dp_5"
                android:paddingTop="@dimen/scaled_h_dp_5" >
                <RelativeLayout
                    android:id="@+id/relayout_billno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/scaled_h_dp_5" >

                    <TextView
                        android:id="@+id/tv_billno_str"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="@dimen/scaled_h_dp_5"
                        android:text="入库单:"
                        android:textColor="@color/white"
                        android:textSize="@dimen/scaled_t_dp_30" />

                    <TextView
                        android:id="@+id/tv_billno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toRightOf="@id/tv_billno_str"
                        android:text=""
                        android:textColor="@color/white"
                        android:layout_marginLeft="@dimen/scaled_h_dp_5"
                        android:textSize="@dimen/scaled_t_dp_30" />
                </RelativeLayout>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingBottom="@dimen/scaled_h_dp_5"
                android:paddingTop="@dimen/scaled_h_dp_5" >
                <RelativeLayout
                    android:id="@+id/relayout_company"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >

                    <TextView
                        android:id="@+id/tv_company_str"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="@dimen/scaled_h_dp_5"
                        android:text="供应商:"
                        android:textColor="@color/white"
                        android:textSize="@dimen/scaled_t_dp_30" />

                    <TextView
                        android:id="@+id/tv_company_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@id/tv_company_str"
                        android:text=""
                        android:layout_marginLeft="@dimen/scaled_h_dp_5"
                        android:textColor="@color/white"
                        android:textSize="@dimen/scaled_t_dp_30" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/relayout_stock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/relayout_company"
                    android:layout_marginTop="@dimen/scaled_h_dp_5"
                    >

                    <TextView
                        android:id="@+id/tv_stock_str"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="@dimen/scaled_h_dp_5"
                        android:text="仓    库:"
                        android:textColor="@color/white"
                        android:textSize="@dimen/scaled_t_dp_30"/>

                    <TextView
                        android:id="@+id/tv_stock_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="@dimen/scaled_h_dp_5"
                        android:layout_toRightOf="@id/tv_stock_str"
                        android:text=""
                        android:textColor="@color/white"
                        android:textSize="@dimen/scaled_t_dp_30"/>

                </RelativeLayout>
            </RelativeLayout>


        </LinearLayout>

        <View
            android:id="@+id/line_billno"
            android:layout_width="match_parent"
            android:layout_height="@dimen/scaled_w_dp_1"
            android:background="#AEAEAE"></View>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/cornflowerblue"
            android:layout_below="@+id/line_billno"

            android:orientation="horizontal" >

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:gravity="center"
                android:paddingBottom="@dimen/scaled_h_dp_15"
                android:paddingTop="@dimen/scaled_h_dp_15"
                android:text="盒标码"
                android:textColor="@color/white"
                android:textSize="@dimen/scaled_t_dp_30" />

            <View
                android:layout_width="@dimen/scaled_w_dp_1"
                android:layout_height="fill_parent"
                android:layout_marginLeft="@dimen/scaled_w_dp_2"
                android:layout_marginRight="@dimen/scaled_w_dp_2"
                android:background="#696969" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.5"
                android:gravity="center_vertical"
                android:orientation="horizontal" >

                <EditText
                    android:id="@+id/et_barcode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/scaled_w_dp_5"
                    android:layout_marginRight="@dimen/scaled_w_dp_5"
                    android:layout_weight="1.5"
                    android:ems="18"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:inputType="text"
                    android:textSize="@dimen/scaled_t_dp_30" >
                    <requestFocus />
                </EditText>

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/relat_boxlabel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                >

                <CheckBox
                    android:id="@+id/check_boxlabel_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layoutDirection="rtl"
                    android:text="是否重打盒标"
                    android:textColor="@color/white"
                    android:textSize="16dp" />
            </RelativeLayout>

        </LinearLayout>

        <View
            android:id="@+id/line_code_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/scaled_w_dp_1"
            android:background="#aeaeae"></View>
