                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="@dimen/scaled_h_dp_10"
                    android:paddingTop="@dimen/scaled_h_dp_10"
                    android:text="当前扫描条码 "
                    android:textSize="@dimen/scaled_t_dp_30"
                    />
            </LinearLayout>

            <View
                android:layout_width="@dimen/scaled_w_dp_1"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/scaled_w_dp_2"
                android:layout_marginRight="@dimen/scaled_w_dp_2"
                android:background="#696969" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.9"
                android:orientation="vertical" >

                <TextView
                    android:id="@+id/tv_show_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/scaled_w_dp_5"
                    android:text=""
                    android:textSize="@dimen/scaled_t_dp_30" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:gravity="center"
                android:orientation="horizontal" >

                <Button
                    android:id="@+id/btn_chooseretail"
                    android:layout_width="fill_parent"
                    android:layout_height="80dp"
                    android:layout_marginRight="@dimen/scaled_w_dp_20"
                    android:text="选择零售商"
                    android:visibility="gone"
                    android:textSize="@dimen/scaled_t_dp_28" />
            </LinearLayout>
        </LinearLayout>

