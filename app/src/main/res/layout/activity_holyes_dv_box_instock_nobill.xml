        <LinearLayout
            android:id="@+id/lin_totalqty_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/relayout_color_view"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:background="#D7D7D7"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/TextView07"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/scaled_h_dp_5"
                    android:paddingBottom="@dimen/scaled_h_dp_5"
                    android:gravity="center"
                    android:text="当前型号\n已入库数"
                    android:textSize="@dimen/scaled_t_dp_26" />

                <View
                    android:layout_width="@dimen/scaled_w_dp_1"
                    android:layout_height="fill_parent"
                    android:background="#AEAEAE" />

                <TextView
                    android:id="@+id/TextView09"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="当前产品\n已入库合计"
                    android:textSize="@dimen/scaled_t_dp_26" />
                <View
                    android:layout_width="@dimen/scaled_w_dp_1"
                    android:layout_height="fill_parent"
                    android:background="#AEAEAE" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="当前已入库\n盒数"
                    android:textSize="@dimen/scaled_t_dp_26" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/scaled_w_dp_1"
                android:background="#aeaeae" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_curqty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:paddingTop="@dimen/scaled_h_dp_10"
                    android:paddingBottom="@dimen/scaled_h_dp_10"
                    android:textColor="@color/darkgreen"
                    android:textSize="@dimen/scaled_t_dp_60"  />

                <View
                    android:layout_width="@dimen/scaled_w_dp_1"
                    android:layout_height="fill_parent"
                    android:background="#AEAEAE" />

                <TextView
                    android:id="@+id/tv_totalqty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/darkgreen"
                    android:textSize="@dimen/scaled_t_dp_60"  />
                <View
                    android:layout_width="@dimen/scaled_w_dp_1"
                    android:layout_height="fill_parent"
                    android:background="#AEAEAE" />

                <TextView
                    android:id="@+id/tv_box_totalqty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/darkgreen"
                    android:textSize="@dimen/scaled_t_dp_60"  />

            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_below="@+id/lin_totalqty_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/scaled_w_dp_1"
            android:background="#AEAEAE"></View>
    </LinearLayout>



    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/LinearLayout01"
        android:paddingTop="@dimen/scaled_h_dp_5"
        android:paddingBottom="@dimen/scaled_h_dp_5">

        <TextView
            android:id="@+id/tv_connect_state_str"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/scaled_h_dp_5"
            android:gravity="center"
            android:text="蓝牙："
            android:textSize="@dimen/scaled_t_sp_20" />

        <TextView
            android:id="@+id/tv_connect_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/tv_connect_state_str"
            android:gravity="center"
            android:text="未连接"
            android:textSize="@dimen/scaled_t_sp_20" />

        <TextView
            android:id="@+id/btn_connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="连接"
            android:textSize="@dimen/scaled_t_dp_26" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/LinearLayout01"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/titlebar_back"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/scaled_h_dp_10"
        android:paddingTop="@dimen/scaled_h_dp_10"
        >


        <Button
            android:id="@+id/btn_list"
            android:layout_width="@dimen/scaled_w_dp_250"
            android:layout_height="@dimen/scaled_h_dp_80"
            android:text="明细"
            android:textSize="@dimen/show_title_size" />

        <Button
            android:id="@+id/btn_print"
            android:layout_width="@dimen/scaled_w_dp_250"
            android:layout_height="@dimen/scaled_h_dp_80"
            android:layout_marginLeft="@dimen/scaled_w_dp_30"
            android:text="打印"
            android:textSize="@dimen/show_title_size" />

        <Button
            android:id="@+id/btn_exit"
            android:layout_width="@dimen/scaled_w_dp_250"
            android:layout_height="@dimen/scaled_h_dp_80"
            android:layout_marginLeft="@dimen/scaled_w_dp_30"
            android:text="完成"
            android:textSize="@dimen/show_title_size" />
    </LinearLayout>
</RelativeLayout>