<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="HardcodedText,dpUsage,InefficientWeight,UselessLeaf" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/titlebar_back"
        android:gravity="center_vertical"
        android:orientation="horizontal" >

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/scaled_h_dp_10"
            android:layout_marginTop="@dimen/scaled_h_dp_10" >

            <TextView
                android:id="@+id/textView1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/scaled_w_dp_10"
                android:text="补标扫描明细查看"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textColor="@color/white"
                android:textSize="@dimen/scaled_t_dp_30" />

            <TextView
                android:id="@+id/tv_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textView1"
                android:layout_marginLeft="@dimen/scaled_w_dp_20"
                android:text="（共 0 条）"
                android:textColor="@color/white"
                android:textSize="@dimen/scaled_t_dp_26" />
        </RelativeLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/burlywood"
        android:gravity="center"
        android:orientation="horizontal" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" >
            <TextView
                android:id="@+id/txt_brand"
                android:layout_width="@dimen/scaled_w_dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:padding="@dimen/scaled_o_dp_10"
                android:text="品牌"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="@dimen/scaled_t_dp_30" />
            <View
                android:layout_width="@dimen/scaled_w_dp_1"
                android:layout_height="fill_parent"
                android:background="#AEAEAE" />
            <TextView
                android:id="@+id/txt_list1"
                android:layout_width="@dimen/scaled_w_dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:padding="@dimen/scaled_o_dp_10"
                android:text="产品ID"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="@dimen/scaled_t_dp_30" />
            <View
                android:layout_width="@dimen/scaled_w_dp_1"
