<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#027BFC"
        android:gravity="center"
        android:padding="10dp"
        android:text="门店列表"
        android:textColor="@color/white"
        android:textSize="16dp" />

    <RelativeLayout
        android:id="@+id/relat_store_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@+id/tv_dialog_title"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingBottom="5dp">

        <EditText
            android:id="@+id/et_store_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@+id/btn_store_search"
            android:hint="请输入门店名称/代号/联系人/电话/地址"
            android:imeOptions="flagNoExtractUi"
            android:paddingLeft="10dp"
            android:singleLine="true"
            android:textSize="14dp" />

        <Button
            android:id="@+id/btn_store_search"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:text="搜索"
            android:textSize="14dp" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/linear_store_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/relat_store_search"
        android:background="@color/burlywood"
        android:gravity="left">

        <include
            layout="@layout/select_ccsstore_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_store_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/linear_store_header"
        android:layout_alignParentRight="true"
        android:padding="5dp"
        android:text="（共 0 条）"
        android:visibility="gone"
        android:textColor="@color/gray"
        android:textSize="12dp" />

    <ListView
        android:id="@+id/listview_store"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btn_close"
        android:layout_below="@+id/tv_store_total"
        android:divider="#AEAEAE"
        android:dividerHeight="0.1dp" />

    <Button
        android:id="@+id/btn_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="关闭"
        android:textSize="14dp" />

</RelativeLayout>
