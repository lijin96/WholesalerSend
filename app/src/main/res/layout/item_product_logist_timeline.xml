<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/scaled_h_dp_15">

    <LinearLayout
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginTop="@dimen/scaled_h_dp_10"
            android:background="@drawable/bg_logist_timeline_dot" />

        <View
            android:id="@+id/view_timeline_line"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/scaled_h_dp_5"
            android:layout_weight="1"
            android:background="@color/logist_timeline_line" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/scaled_w_dp_10"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_logist_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/logist_text_value"
                android:textSize="@dimen/scaled_t_dp_24" />

            <TextView
                android:id="@+id/tv_kind_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/scaled_w_dp_10"
                android:background="@drawable/bg_logist_tag"
                android:paddingLeft="@dimen/scaled_w_dp_10"
                android:paddingTop="@dimen/scaled_o_dp_4"
                android:paddingRight="@dimen/scaled_w_dp_10"
                android:paddingBottom="@dimen/scaled_o_dp_4"
                android:textColor="@color/logist_accent"
                android:textSize="@dimen/scaled_t_dp_22" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_lno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/scaled_h_dp_8"
            android:textColor="@color/logist_text_value"
            android:textSize="@dimen/scaled_t_dp_24" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/scaled_h_dp_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="从"
                android:textColor="@color/logist_text_label"
                android:textSize="@dimen/scaled_t_dp_22" />

            <TextView
                android:id="@+id/tv_from_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/scaled_w_dp_6"
                android:background="@drawable/bg_logist_flow_badge"
                android:paddingLeft="@dimen/scaled_w_dp_10"
                android:paddingTop="@dimen/scaled_o_dp_4"
                android:paddingRight="@dimen/scaled_w_dp_10"
                android:paddingBottom="@dimen/scaled_o_dp_4"
                android:textColor="@color/white"
                android:textSize="@dimen/scaled_t_dp_22" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/scaled_w_dp_6"
                android:layout_marginRight="@dimen/scaled_w_dp_6"
                android:text="→"
                android:textColor="@color/logist_text_label"
                android:textSize="@dimen/scaled_t_dp_22" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="到"
                android:textColor="@color/logist_text_label"
                android:textSize="@dimen/scaled_t_dp_22" />

            <TextView
                android:id="@+id/tv_to_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/scaled_w_dp_6"
                android:background="@drawable/bg_logist_flow_badge"
                android:paddingLeft="@dimen/scaled_w_dp_10"
                android:paddingTop="@dimen/scaled_o_dp_4"
                android:paddingRight="@dimen/scaled_w_dp_10"
                android:paddingBottom="@dimen/scaled_o_dp_4"
                android:textColor="@color/white"
                android:textSize="@dimen/scaled_t_dp_22" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_user_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/scaled_h_dp_8"
            android:textColor="@color/logist_text_label"
            android:textSize="@dimen/scaled_t_dp_22" />
    </LinearLayout>
</LinearLayout>
