<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gridview_selector_view"
    >
    <TextView
        android:id="@+id/grid_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0.00"
        android:textColor="@color/black"
        android:gravity="center"
        android:textSize="@dimen/scaled_t_dp_30"
        android:paddingTop="@dimen/scaled_h_dp_5"/>
    <TextView
        android:id="@+id/grid_num"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="采购数"
        android:textColor="@color/gray"
        android:gravity="center"
        android:textSize="@dimen/scaled_t_dp_20"
        android:paddingTop="@dimen/scaled_h_dp_3"
        android:paddingBottom="@dimen/scaled_h_dp_5"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/scaled_h_dp_1"
        android:background="@color/gray"></View>
    
</LinearLayout>