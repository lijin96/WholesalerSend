<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="HardcodedText" >

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/scaled_h_dp_1"
        android:background="#AEAEAE" />

    <TextView
        android:id="@+id/new_scanorder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="@dimen/scaled_t_dp_24"
        android:padding="@dimen/scaled_o_dp_15"
        android:text="请选择要绑定的品牌">

    </TextView>


    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/scaled_h_dp_1"
        android:visibility="gone"
        android:background="#AEAEAE" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="horizontal" >

        <TextView
            android:id="@+id/txt_list1"
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:padding="@dimen/scaled_o_dp_10"
            android:text="扫描单号"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="@dimen/scaled_t_dp_20" />

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="match_parent"
            android:background="#AEAEAE" />

        <TextView
            android:id="@+id/txt_list2"
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="@dimen/scaled_o_dp_10"
            android:text="扫描数量"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="@dimen/scaled_t_dp_20" />

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="match_parent"
            android:background="#AEAEAE" />

        <TextView
            android:id="@+id/txt_list3"
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:padding="@dimen/scaled_o_dp_10"
            android:text="扫描时间"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="@dimen/scaled_t_dp_20" />

    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/scaled_h_dp_1"
        android:background="#AEAEAE" />

    <ListView
        android:id="@+id/List_BindBrand"
        android:layout_width="match_parent"
        android:layout_height="match_parent"></ListView>


</LinearLayout>