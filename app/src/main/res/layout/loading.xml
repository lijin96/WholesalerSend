<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:ignore="Uselesdparent,HardcodedText,ContentDescription">

    <LinearLayout
        android:layout_width="@dimen/scaled_w_dp_300"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/scaled_h_dp_5"
        android:layout_marginLeft="@dimen/scaled_w_dp_10"
        android:layout_marginRight="@dimen/scaled_w_dp_10"
        android:layout_marginTop="@dimen/scaled_h_dp_5">

        <ImageView
            android:id="@+id/imgLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/loading"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/scaled_w_dp_10"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progressBar2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="@dimen/scaled_w_dp_200"
                android:layout_height="@dimen/scaled_h_dp_10"
                android:layout_marginBottom="@dimen/scaled_h_dp_5"
                android:layout_marginLeft="@dimen/scaled_w_dp_10"
                android:layout_marginRight="@dimen/scaled_w_dp_10"
                android:layout_marginTop="@dimen/scaled_h_dp_5"
                android:max="100"
                android:progress="100"
                android:visibility="visible"/>

            <TextView
                android:id="@+id/txtTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="提示..."
                android:textColor="@color/black"/>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnEsc"
        android:layout_width="@dimen/scaled_w_dp_60"
        android:layout_height="@dimen/scaled_h_dp_35"
        android:layout_marginBottom="@dimen/scaled_h_dp_5"
        android:layout_marginTop="@dimen/scaled_h_dp_5"
        android:text="取消"/>

</LinearLayout>