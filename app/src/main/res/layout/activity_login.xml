<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/LinearLayout1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login"
    android:orientation="vertical"
    tools:ignore="HardcodedText,Deprecated,ContentDescription,ObsoleteLayoutParam,InefficientWeight,NestedWeights,Uselesdparent"
    >


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="@dimen/scaled_w_dp_42"
            android:layout_marginBottom="@dimen/scaled_h_dp_18"
            android:src="@drawable/link_state_on" />

        <TextView
            android:id="@+id/tv_versionCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_marginTop="@dimen/scaled_h_dp_10"
            android:layout_marginRight="@dimen/scaled_w_dp_10"
            android:text=""
            android:textColor="@color/white"
            android:textSize="@dimen/login_font_size" />

        <TextView
            android:id="@+id/texBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_versionCode"
            android:layout_centerHorizontal="true"
            android:paddingTop="@dimen/login_paddingTop"
            android:text="HOLYES"
            android:textSize="@dimen/login_font_size"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textColor="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/texBrand"
            android:layout_centerInParent="true"
            android:layout_marginTop="@dimen/scaled_h_dp_10"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/logincheckBox"
                android:layout_alignParentLeft="true"
                android:gravity="center_horizontal"
                android:layout_marginTop="@dimen/scaled_h_dp_30"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="@dimen/login_width"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="账\t号："
                        android:textColor="@color/white"
                        android:textSize="@dimen/scaled_t_dp_24" />

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/login_height"
                        android:layout_weight="0.5"
                        android:background="@drawable/textback"
                        android:ems="10"
                        android:hint="用户账号"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="text"
                        android:singleLine="true"
                        android:paddingLeft="@dimen/scaled_w_dp_5"
                        android:textColor="@color/black"
                        android:textSize="@dimen/login_font_size">

                        <requestFocus />
                    </EditText>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="@dimen/login_width"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/scaled_h_dp_20"
                    android:layout_weight="1"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="密\t码："
                        android:textColor="@color/white"
                        android:textSize="@dimen/scaled_t_dp_24" />

                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/login_height"
                        android:layout_marginTop="@dimen/scaled_h_dp_0"
                        android:layout_weight="1"
                        android:background="@drawable/textback"
                        android:ems="10"
                        android:hint="密 码"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:paddingLeft="@dimen/scaled_w_dp_5"
                        android:textColor="@color/black"
                        android:textSize="@dimen/login_font_size" />
                </LinearLayout>
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/linearLayout2"
                android:layout_marginTop="@dimen/login_marginTop"
                android:layout_marginBottom="@dimen/login_marginTop">

                <CheckBox
                    android:id="@+id/logincheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_weight="0"
                    android:text="记住密码"
                    android:textColor="@color/white"
                    android:textSize="@dimen/login_font_size" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/linearLayout2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/imageView1"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="@dimen/login_marginTop"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/lin_icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:layout_width="@dimen/scaled_w_dp_250"
                        android:layout_height="@dimen/scaled_h_dp_0_5"
                        android:layout_marginBottom="@dimen/login_marginTop"
                        android:background="#7DC5EB" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/lin_login"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/scaled_w_dp_20"
                            android:layout_marginRight="@dimen/scaled_w_dp_20"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/btn_login_background" />

                            <TextView
                                android:id="@+id/tv_login"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="登录"
                                android:textColor="@color/white"
                                android:textSize="@dimen/login_font_size" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/lin_setting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/scaled_w_dp_20"
                            android:layout_marginRight="@dimen/scaled_w_dp_20"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/btn_set_background" />

                            <TextView
                                android:id="@+id/btn_setting"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="设置"
                                android:textColor="@color/white"
                                android:textSize="@dimen/login_font_size" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/lin_update"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/scaled_w_dp_20"
                            android:layout_marginRight="@dimen/scaled_w_dp_20"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/btn_about_background" />

                            <TextView
                                android:id="@+id/btn_update"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="关于"
                                android:textColor="@color/white"
                                android:textSize="@dimen/login_font_size" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/lin_evaluate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/scaled_w_dp_20"
                            android:layout_marginRight="@dimen/scaled_w_dp_20"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/btn_evalute_background" />

                            <TextView
                                android:id="@+id/btn_evaluate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="评价建议"
                                android:textColor="@color/white"
                                android:textSize="@dimen/login_font_size" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>