<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main"
    android:orientation="vertical">

    <TextView
        android:id="@+id/texBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:paddingTop="@dimen/scaled_h_dp_30"
        android:text="HOLYES"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="@color/white"
        android:textSize="@dimen/login_font_size" />


    <ImageView
        android:id="@+id/imageView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_marginBottom="@dimen/scaled_h_dp_20"
        android:layout_marginLeft="@dimen/scaled_w_dp_42"
        android:src="@drawable/link_state_on" />

    <RelativeLayout
        android:layout_below="@+id/texBrand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">

        <LinearLayout
            android:id="@+id/linearLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="@dimen/scaled_h_dp_30"
            android:gravity="center">


            <Button
                android:id="@+id/btn_instock_in"
                android:layout_width="@dimen/scaled_w_dp_150"
                android:layout_height="@dimen/scaled_h_dp_80"
                android:background="@drawable/btn_instock_in_background" />

            <Button
                android:id="@+id/btn_sendgoods_d"
                android:layout_width="@dimen/scaled_w_dp_150"
                android:layout_height="@dimen/scaled_h_dp_80"
                android:layout_marginLeft="@dimen/scaled_w_dp_50"
                android:background="@drawable/btn_new_sendgoods_d_background" />

            <Button
                android:id="@+id/btn_sendgoods_zy"
                android:layout_width="@dimen/scaled_w_dp_150"
                android:layout_height="@dimen/scaled_h_dp_80"
                android:layout_marginLeft="@dimen/scaled_w_dp_50"
                android:background="@drawable/btn_sendgoods_zy_background" />

            <Button
                android:id="@+id/btn_otherscan"
                android:layout_width="@dimen/scaled_w_dp_150"
                android:layout_height="@dimen/scaled_h_dp_80"
                android:layout_marginLeft="@dimen/scaled_w_dp_50"
                android:background="@drawable/btn_otherscan_background"
                android:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/linearLayout1"
            android:layout_alignParentLeft="true"
            android:layout_marginTop="@dimen/scaled_h_dp_25"
            android:gravity="center">


            <Button
                android:id="@+id/btn_instock_back"
                android:layout_width="@dimen/scaled_w_dp_150"
                android:layout_height="@dimen/scaled_h_dp_80"
                android:background="@drawable/btn_instock_back_background" />

            <Button
                android:id="@+id/btn_backgoods_d"
                android:layout_width="@dimen/scaled_w_dp_150"
                android:layout_height="@dimen/scaled_h_dp_80"
                android:layout_marginLeft="@dimen/scaled_w_dp_50"
                android:background="@drawable/btn_new_backgoods_d_background" />

            <Button
                android:id="@+id/btn_backgoods_zy"
                android:layout_width="@dimen/scaled_w_dp_150"
                android:layout_height="@dimen/scaled_h_dp_80"
                android:layout_marginLeft="@dimen/scaled_w_dp_50"
                android:background="@drawable/btn_backgoods_zy_background" />

            <Button
                android:id="@+id/btn_product_logist"
                android:layout_width="@dimen/scaled_w_dp_150"
                android:layout_height="@dimen/scaled_h_dp_80"
                android:layout_marginLeft="@dimen/scaled_w_dp_50"
                android:background="@drawable/btn_seeklogist_background"
                android:visibility="visible" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/relayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/linearLayout2"
            android:layout_alignParentLeft="true"
            android:layout_marginTop="@dimen/scaled_h_dp_50"
            android:gravity="center"
            android:paddingBottom="@dimen/scaled_h_dp_150">

            <Button
                android:id="@+id/btn_set"
                android:layout_width="@dimen/scaled_w_dp_60"
                android:layout_height="@dimen/scaled_h_dp_60"
                android:background="@drawable/btn_os_set" />

            <TextView
                android:id="@+id/tv_set"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btn_set"
                android:text="设置"
                android:textColor="@color/white"
                android:textSize="@dimen/scaled_t_dp_26" />

            <Button
                android:id="@+id/btn_function"
                android:layout_width="@dimen/scaled_w_dp_60"
                android:layout_height="@dimen/scaled_h_dp_60"
                android:layout_marginLeft="@dimen/scaled_w_dp_100"
                android:layout_marginRight="@dimen/scaled_w_dp_100"
                android:layout_toRightOf="@id/btn_set"
                android:background="@drawable/btn_function" />

            <TextView
                android:id="@+id/tv_function"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btn_function"
                android:layout_alignLeft="@id/btn_function"
                android:layout_marginLeft="@dimen/scaled_w_dp_neg15"
                android:layout_marginTop="@dimen/scaled_h_dp_0"
                android:layout_toRightOf="@id/tv_set"
                android:text="切换账套"
                android:textColor="@color/white"
                android:textSize="@dimen/scaled_t_dp_24" />

            <Button
                android:visibility="gone"
                android:id="@+id/btn_update"
                android:layout_width="@dimen/scaled_w_dp_60"
                android:layout_height="@dimen/scaled_h_dp_60"
                android:layout_toRightOf="@id/btn_function"
                android:background="@drawable/ccs" />

            <TextView
                android:visibility="gone"
                android:id="@+id/tv_update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btn_update"
                android:layout_alignLeft="@id/btn_update"
                android:layout_marginLeft="@dimen/scaled_w_dp_neg15"
                android:layout_toRightOf="@id/tv_function"
                android:text="CCS功能"
                android:textColor="@color/white"
                android:textSize="@dimen/scaled_t_dp_26" />
        </RelativeLayout>
    </RelativeLayout>

</RelativeLayout>