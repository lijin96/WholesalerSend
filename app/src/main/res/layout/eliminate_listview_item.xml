<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal" >

        <TextView
            android:id="@+id/tv_model_colors"
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingBottom="@dimen/scaled_h_dp_10"
            android:paddingTop="@dimen/scaled_h_dp_10"
            android:text="型号-色号"
            android:textSize="@dimen/scaled_t_dp_30" />

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="fill_parent"
            android:background="#AAAAAA" />

        <TextView
            android:id="@+id/tv_barcode"
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="产品条码"
            android:textSize="@dimen/scaled_t_dp_30" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/scaled_h_dp_0_5"
        android:background="#BFBFBF" />

</LinearLayout>
