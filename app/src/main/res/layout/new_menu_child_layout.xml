<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal" 
    android:paddingLeft="@dimen/scaled_w_dp_25"
    android:gravity="center_vertical">
    <ImageView 
        android:id="@+id/iv_child"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/point_blue"
        android:layout_marginRight="@dimen/scaled_w_dp_10"
        android:layout_marginLeft="@dimen/scaled_w_dp_80"/>
    <TextView  
        android:id="@+id/tv_child_title"  
        android:layout_width="wrap_content"  
        android:layout_height="wrap_content"  
        android:gravity="center_vertical"  
        android:textSize="@dimen/scaled_t_dp_22"  
        android:textStyle="bold" 
        android:textColor="#000000"
        android:text="有单发货"
        android:padding="@dimen/scaled_o_dp_15">  
    </TextView>  
  
    <CheckBox  
        android:id="@+id/check_child"  
        android:layout_width="wrap_content"  
        android:layout_height="wrap_content"  
        android:clickable="false"  
        android:focusable="false" 
        android:visibility="gone"/>  

</LinearLayout>
