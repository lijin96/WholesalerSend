<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:ignore="TextFields,HardcodedText,InefficientWeight,Uselesdparent" >

    <RelativeLayout
        android:id="@+id/LinearLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/titlebar_back"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/scaled_o_dp_10" >

        <LinearLayout
            android:id="@+id/lin_company_d1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/TextView02"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="选择客户"
                android:textColor="@color/white"
                android:textSize="@dimen/scaled_t_dp_30" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" >

                <TextView
                    android:id="@+id/tv_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="（共 0 条）"
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_28" />

                <TextView
                    android:visibility="gone"
                    android:id="@+id/company_retailer_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="找不到资料？"
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_28" />
            </LinearLayout>
        </LinearLayout>

<!--        <Button-->
<!--            android:id="@+id/btn_filter"-->
<!--            android:layout_width="@dimen/scaled_w_dp_100"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_alignParentRight="true"-->
<!--            android:layout_centerVertical="true"-->
<!--            android:layout_marginRight="@dimen/scaled_w_dp_10"-->
<!--            android:text="筛选" />-->

        <EditText
            android:id="@+id/et_search"
            android:layout_width="@dimen/scaled_w_dp_350"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/scaled_w_dp_5"
            android:singleLine="true"
            android:imeOptions="flagNoExtractUi"
            android:layout_toLeftOf="@id/btn_search"
            android:hint="输入条件点击确定查找" />

        <Button
            android:id="@+id/btn_search"
            android:layout_width="@dimen/scaled_w_dp_100"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/scaled_w_dp_10"
            android:text="确定" />


    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/burlywood"
        android:gravity="left" >

        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/lst_company_item" />
    </LinearLayout>

    <ListView
        android:id="@+id/lst_company"
        android:layout_width="match_parent"
        android:layout_height="@dimen/scaled_h_dp_221"
        android:layout_weight="1.24" >
    </ListView>

    <LinearLayout
        android:id="@+id/LinearLayout01"
        android:layout_width="match_parent"
        android:layout_height="@dimen/scaled_h_dp_25"
        android:background="@drawable/titlebar_back"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone" >

        <Button
            android:id="@+id/btn_exit"
            android:layout_width="@dimen/scaled_w_dp_90"
            android:layout_height="wrap_content"
            android:text="返回" />
    </LinearLayout>

</LinearLayout>