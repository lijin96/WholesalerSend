<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/RelativeLayout1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="Deprecated,ContentDescription,HardcodedText,ObsoleteLayoutParam" >

    <ImageView
        android:id="@+id/titleimage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_title_height"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_x="@dimen/scaled_o_dp_0"
        android:layout_y="@dimen/scaled_o_dp_0"
        android:scaleType="fitXY"
        android:src="@drawable/titlebackground" />

    <Button
        android:id="@+id/titlebtn1"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="@dimen/app_titleexit_width"
        android:layout_height="@dimen/app_titleexit_height"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="@dimen/scaled_w_dp_6"
        android:layout_marginTop="@dimen/scaled_h_dp_10"
        android:layout_marginBottom="@dimen/scaled_h_dp_10"
        android:textSize="@dimen/login_font_size"
        android:background="@drawable/titlebtnback" />
    <!-- android:visibility="gone" -->

    <TextView
        android:id="@+id/titletext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/titleimage"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/scaled_h_dp_15"
        android:gravity="center_horizontal"
        android:text="标题"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/titlebtn2"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="@dimen/app_titleexit_width"
        android:layout_height="@dimen/app_titleexit_height"
        android:layout_alignParentRight="true"
        android:layout_alignTop="@+id/titlebtn1"
        android:background="@drawable/button_background"
        android:text="升级"
        android:textSize="@dimen/login_font_size"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        android:visibility="visible" 
        android:layout_marginRight="@dimen/scaled_w_dp_10"/>

</RelativeLayout>