<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/titlebar_back"
        android:orientation="horizontal" >

        <LinearLayout
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/scaled_o_dp_10"
            android:layout_weight="1">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical" >

                <TextView
                    android:id="@+id/tv_supplier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="供应商："
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />

                <TextView
                    android:id="@+id/tv_supplier_str"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/scaled_w_dp_10"
                    android:layout_toRightOf="@id/tv_supplier"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/scaled_o_dp_10">

                <TextView
                    android:id="@+id/tv_stock_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="仓库："
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />

                <TextView
                    android:id="@+id/tv_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/scaled_w_dp_10"
                    android:layout_toRightOf="@id/tv_stock_title"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />
            </RelativeLayout>
        </LinearLayout>

        <RelativeLayout
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="@dimen/scaled_o_dp_20"
            android:gravity="center_vertical" >

            <TextView
                android:id="@+id/tv_BoxNo_Code_str"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前盒标码："
                android:textColor="@color/white"
                android:textSize="@dimen/scaled_t_dp_30" />

            <TextView
                android:id="@+id/tv_BoxNo_Code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/scaled_w_dp_10"
                android:layout_toRightOf="@id/tv_BoxNo_Code_str"
                android:text=""
                android:textColor="@color/white"
                android:textSize="@dimen/scaled_t_dp_30" />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cornflowerblue"
        android:orientation="horizontal" >

        <TextView
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:gravity="center"
            android:paddingBottom="@dimen/scaled_h_dp_15"
            android:paddingTop="@dimen/scaled_h_dp_15"
            android:text="条\t\t码"
            android:textColor="@color/white"
            android:textSize="@dimen/scaled_t_dp_30" />

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/scaled_w_dp_2"
            android:layout_marginRight="@dimen/scaled_w_dp_2"
            android:background="#696969" />

        <View
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="fill_parent"
            android:layout_weight="0.05" />

        <EditText
            android:id="@+id/et_barcode"
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="2.4"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:textSize="@dimen/scaled_t_dp_30">

            <requestFocus />
        </EditText>

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="fill_parent" />

        <View
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="fill_parent"
            android:layout_weight="0.05" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/scaled_h_dp_100"
        android:background="#A2A2A2"
        android:gravity="center_vertical"
        android:orientation="horizontal" >

        <RelativeLayout
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:gravity="center" >

            <TextView
                android:id="@+id/tv_model_color_str"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="型号色号"
                android:textSize="@dimen/scaled_t_dp_30" />

            <TextView
                android:id="@+id/tv_productid_str"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_model_color_str"
                android:gravity="center"
                android:text="（产品ID）"
                android:textSize="@dimen/scaled_t_dp_28" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:gravity="center_vertical"
            android:orientation="horizontal" >

            <View
                android:layout_width="@dimen/scaled_w_dp_1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/scaled_w_dp_2"
                android:layout_marginRight="@dimen/scaled_w_dp_2"
                android:background="#696969" />

            <RelativeLayout
                android:layout_width="@dimen/scaled_w_dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1" >

                <TextView
                    android:id="@+id/tv_model_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/scaled_w_dp_10"
                    android:text="请先选择型号色号>>>"
                    android:textSize="@dimen/scaled_t_dp_30" />

                <TextView
                    android:id="@+id/tv_productid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_model_color"
                    android:paddingLeft="@dimen/scaled_w_dp_20"
                    android:textSize="@dimen/scaled_t_dp_28" />
            </RelativeLayout>

            <Button
                android:id="@+id/btn_select_model_color"
                android:layout_width="@dimen/scaled_w_dp_100"
                android:layout_height="@dimen/scaled_h_dp_50"
                android:background="@drawable/button_background"
                android:text="选择"
                android:textSize="@dimen/scaled_t_dp_24" />
        </LinearLayout>

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/scaled_w_dp_2"
            android:layout_marginRight="@dimen/scaled_w_dp_2"
            android:background="#696969" />

        <RelativeLayout
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1.1" >

            <TextView
                android:id="@+id/tv_packing_number_str"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="盒装数："
                android:textSize="@dimen/scaled_t_dp_26" />

            <TextView
                android:id="@+id/tv_packing_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/tv_packing_number_str"
                android:text=""
                android:textSize="@dimen/scaled_t_dp_26" />

            <Button
                android:id="@+id/btn_set_packing_number"
                android:layout_width="@dimen/scaled_w_dp_100"
                android:layout_height="@dimen/scaled_h_dp_50"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/scaled_w_dp_15"
                android:layout_toLeftOf="@+id/btn_test_packing"
                android:background="@drawable/button_background"
                android:text="设置"
                android:textSize="@dimen/scaled_t_dp_24" />

            <Button
                android:id="@+id/btn_test_packing"
                android:layout_width="@dimen/scaled_w_dp_120"
                android:layout_height="@dimen/scaled_h_dp_50"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/scaled_h_dp_10"
                android:background="@drawable/button_background"
                android:text="测试打印"
                android:textSize="@dimen/scaled_t_dp_24" />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/scaled_h_dp_0"
        android:layout_weight="1"
        android:orientation="horizontal" >


        <RelativeLayout
            android:id="@+id/relayout_box_count"
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="fill_parent"
            android:layout_weight="1" >

            <RelativeLayout
                android:id="@+id/relayout_box_count_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#D7D7D7"
                android:gravity="center"
                android:paddingBottom="@dimen/scaled_h_dp_10"
                android:paddingTop="@dimen/scaled_h_dp_10" >

                <TextView
                    android:id="@+id/tv_box_count_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:paddingTop="@dimen/scaled_h_dp_0"
                    android:paddingBottom="@dimen/scaled_h_dp_0"
                    android:text="当前盒已装数量"
                    android:textSize="@dimen/scaled_t_dp_30" />

            </RelativeLayout>

            <View
                android:id="@+id/line_box_left"
                android:layout_width="match_parent"
                android:layout_height="@dimen/scaled_h_dp_1"
                android:layout_below="@id/relayout_box_count_title"
                android:background="#D7D7D7" />

            <TextView
                android:id="@+id/tv_box_count"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:layout_below="@id/line_box_left"
                android:gravity="center"
                android:padding="@dimen/scaled_o_dp_5"
                android:text="0"
                android:textSize="@dimen/scaled_t_dp_60" />
        </RelativeLayout>

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="fill_parent"
            android:background="#696969" />

        <RelativeLayout
            android:id="@+id/relayout_one_count"
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="fill_parent"
            android:layout_weight="1" >

            <RelativeLayout
                android:id="@+id/relayout_one_count_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#D7D7D7"
                android:gravity="center"
                android:paddingBottom="@dimen/scaled_h_dp_10"
                android:paddingTop="@dimen/scaled_h_dp_10" >

                <TextView
                    android:id="@+id/tv_one_count_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:paddingTop="@dimen/scaled_h_dp_0"
                    android:paddingBottom="@dimen/scaled_h_dp_0"
                    android:text="当前型号已装数"
                    android:textSize="@dimen/scaled_t_dp_30" />

            </RelativeLayout>

            <View
                android:id="@+id/line_left"
                android:layout_width="match_parent"
                android:layout_height="@dimen/scaled_h_dp_1"
                android:layout_below="@id/relayout_one_count_title"
                android:background="#D7D7D7" />

            <TextView
                android:id="@+id/tv_one_count"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:layout_below="@id/line_left"
                android:gravity="center"
                android:padding="@dimen/scaled_o_dp_5"
                android:text="0"
                android:textSize="@dimen/scaled_t_dp_60" />
        </RelativeLayout>

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="fill_parent"
            android:background="#696969" />

        <RelativeLayout
            android:id="@+id/relayout_all_count"
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="fill_parent"
            android:layout_weight="1" >

            <RelativeLayout
                android:id="@+id/relayout_all_count_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#D7D7D7"
                android:paddingBottom="@dimen/scaled_h_dp_10"
                android:paddingTop="@dimen/scaled_h_dp_10" >

                <TextView
                    android:id="@+id/tv_all_count_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:text="当前已装产品总数"
                    android:textSize="@dimen/scaled_t_dp_30" />

            </RelativeLayout>

            <View
                android:id="@+id/line_right"
                android:layout_width="match_parent"
                android:layout_height="@dimen/scaled_h_dp_1"
                android:layout_below="@id/relayout_all_count_title"
                android:background="#D7D7D7" />

            <TextView
                android:id="@+id/tv_all_count"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:layout_below="@+id/line_right"
                android:gravity="center"
                android:padding="@dimen/scaled_o_dp_5"
                android:text="0"
                android:textSize="@dimen/scaled_t_dp_60" />
        </RelativeLayout>

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="fill_parent"
            android:background="#696969" />

        <RelativeLayout
            android:id="@+id/relayout_all_box"
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="fill_parent"
            android:layout_weight="1" >

            <RelativeLayout
                android:id="@+id/relayout_all_box_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#D7D7D7"
                android:paddingBottom="@dimen/scaled_h_dp_10"
                android:paddingTop="@dimen/scaled_h_dp_10" >

                <TextView
                    android:id="@+id/tv_all_box_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:text="当前已装盒数"
                    android:textSize="@dimen/scaled_t_dp_30" />

            </RelativeLayout>

            <View
                android:id="@+id/line_box"
                android:layout_width="match_parent"
                android:layout_height="@dimen/scaled_h_dp_1"
                android:layout_below="@id/relayout_all_box_title"
                android:background="#D7D7D7" />

            <TextView
                android:id="@+id/tv_all_box"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:layout_below="@+id/line_box"
                android:gravity="center"
                android:padding="@dimen/scaled_o_dp_5"
                android:text="0"
                android:textSize="@dimen/scaled_t_dp_60" />
        </RelativeLayout>

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D7D7D7"
        android:padding="@dimen/scaled_o_dp_10" >

        <TextView
            android:id="@+id/tv_connect_state_str"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/scaled_w_dp_50"
            android:gravity="center"
            android:text="蓝牙打印机："
            android:textSize="@dimen/scaled_t_dp_30" />

        <TextView
            android:id="@+id/tv_connect_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/tv_connect_state_str"
            android:gravity="center"
            android:text="未连接"
            android:textSize="@dimen/scaled_t_dp_30" />

        <TextView
            android:id="@+id/tv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/scaled_w_dp_50"
            android:gravity="center"
            android:text="可扫描"
            android:textSize="@dimen/scaled_t_dp_30"
            android:visibility="gone" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/titlebar_back"
        android:gravity="center"
        android:paddingBottom="@dimen/scaled_h_dp_10"
        android:paddingTop="@dimen/scaled_h_dp_10" >

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="@dimen/scaled_w_dp_150"
            android:layout_height="@dimen/scaled_h_dp_60"
            android:text="连接"
            android:textSize="@dimen/scaled_t_dp_28" />


        <Button
            android:id="@+id/btn_scan_print"
            android:layout_width="@dimen/scaled_w_dp_150"
            android:layout_height="@dimen/scaled_h_dp_60"
            android:layout_marginLeft="@dimen/scaled_w_dp_30"
            android:layout_toRightOf="@id/btn_connect"
            android:text="扫描打印"
            android:visibility="gone"
            android:textSize="@dimen/scaled_t_dp_28" />

        <Button
            android:id="@+id/btn_again_print_boxcode"
            android:layout_width="@dimen/scaled_w_dp_150"
            android:layout_height="@dimen/scaled_h_dp_60"
            android:layout_marginLeft="@dimen/scaled_w_dp_30"
            android:layout_toRightOf="@id/btn_scan_print"
            android:text="补打盒标"
            android:textSize="@dimen/scaled_t_dp_28" />

        <Button
            android:id="@+id/btn_eliminate"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/scaled_h_dp_60"
            android:layout_marginLeft="@dimen/scaled_w_dp_30"
            android:layout_toRightOf="@id/btn_again_print_boxcode"
            android:text="当前盒剔除"
            android:textSize="@dimen/scaled_t_dp_28" />

        <Button
            android:id="@+id/btn_history_eliminate"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/scaled_h_dp_60"
            android:layout_marginLeft="@dimen/scaled_w_dp_30"
            android:layout_toRightOf="@id/btn_eliminate"
            android:text="历史盒剔除"
            android:textSize="@dimen/scaled_t_dp_28" />


        <Button
            android:id="@+id/btn_finish"
            android:layout_width="@dimen/scaled_w_dp_150"
            android:layout_height="@dimen/scaled_h_dp_60"
            android:layout_marginLeft="@dimen/scaled_w_dp_30"
            android:layout_toRightOf="@id/btn_history_eliminate"
            android:text="完成"
            android:textSize="@dimen/scaled_t_dp_28" />
    </RelativeLayout>

</LinearLayout>
