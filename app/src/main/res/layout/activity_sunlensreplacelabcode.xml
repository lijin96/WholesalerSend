<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:gravity="left"
        android:paddingLeft="@dimen/scaled_w_dp_10"
        android:text="【】"
        android:textColor="@color/white"
        android:textSize="@dimen/scaled_t_dp_30" />


    <LinearLayout
        android:id="@+id/linelayout_middle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="2.88"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#DFDFDF"
            android:padding="@dimen/scaled_o_dp_10">

            <TextView
                android:id="@+id/tv_new_mess"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/scaled_w_dp_50"
                android:gravity="left"
                android:text="出库单号："
                android:textColor="@color/black"
                android:textSize="@dimen/scaled_t_dp_30" />

            <EditText
                android:id="@+id/et_outstock_order"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/scaled_w_dp_10"
                android:layout_marginRight="@dimen/scaled_w_dp_20"
                android:layout_toRightOf="@id/tv_new_mess"
                android:hint="请先扫描出库单号"
                android:singleLine="true"
                android:textSize="@dimen/scaled_t_dp_30">

                <requestFocus />
            </EditText>
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/scaled_h_dp_1"
            android:background="#AEAEAE" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#DFDFDF"
            android:padding="@dimen/scaled_o_dp_10">

            <TextView
                android:id="@+id/tv_old_mess"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/scaled_w_dp_50"
                android:gravity="left"
                android:text="物流条码："
                android:textColor="@color/black"
                android:textSize="@dimen/scaled_t_dp_30" />

            <EditText
                android:id="@+id/et_outstock_code"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/scaled_w_dp_10"
                android:layout_marginRight="@dimen/scaled_w_dp_20"
                android:layout_toRightOf="@id/tv_old_mess"
                android:hint="请扫描物流码"
                android:nextFocusForward="@id/et_new_code"
                android:singleLine="true"
                android:textSize="@dimen/scaled_t_dp_30" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/scaled_h_dp_1"
            android:background="#AEAEAE" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/scaled_t_dp_20">

            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/scaled_w_dp_50"
                android:layout_marginTop="@dimen/scaled_h_dp_10"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/tv_new_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="出库单号："
                    android:textColor="@color/black"
                    android:textSize="@dimen/scaled_t_dp_30" />

                <TextView
                    android:id="@+id/tv_old_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_new_code"
                    android:text="物流码："
                    android:layout_marginTop="@dimen/scaled_h_dp_5"
                    android:textColor="@color/black"
                    android:textSize="@dimen/scaled_t_dp_30" />
            </RelativeLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/scaled_w_dp_50"
                android:layout_marginTop="@dimen/scaled_t_dp_20"
                android:text="扫码成功数量"
                android:textSize="@dimen/scaled_t_dp_30" />


            <TextView
                android:id="@+id/tv_Scannum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="20dp"
                android:text="0"
                android:textColor="@color/black"
                android:textSize="@dimen/scaled_t_dp_30" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/scaled_t_dp_20"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/scaled_w_dp_50"
                android:text="型号色号"
                android:textSize="@dimen/scaled_t_dp_30" />

            <TextView
                android:id="@+id/tv_goodname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/scaled_t_dp_30"
                android:text=""
                android:textSize="@dimen/scaled_t_dp_30" />
        </LinearLayout>
    </LinearLayout>

