<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="@dimen/scaled_h_dp_20"
        >
       <TextView
           android:layout_width="@dimen/scaled_w_dp_200"
           android:layout_height="wrap_content"
           android:text="当前选择的球柱镜"
           android:textSize="@dimen/scaled_t_dp_24"
           >
       </TextView>
        <TextView
            android:id="@+id/procure_sphericalprism"
            android:layout_width="@dimen/scaled_w_dp_200"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/scaled_w_dp_20"
            android:text="11111"
            android:textSize="@dimen/scaled_t_dp_24"
            ></TextView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:paddingTop="@dimen/scaled_h_dp_20"
        >
        <TextView
            android:layout_width="@dimen/scaled_w_dp_200"
            android:layout_height="wrap_content"
            android:text="当前采购订单数"
            android:textSize="@dimen/scaled_t_dp_24"
            >
        </TextView>
        <TextView
            android:id="@+id/procure_num"
            android:layout_width="@dimen/scaled_w_dp_200"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/scaled_w_dp_20"
            android:text="11111"
            android:textSize="@dimen/scaled_t_dp_24"
            ></TextView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:paddingTop="@dimen/scaled_h_dp_20"
        android:paddingBottom="@dimen/scaled_h_dp_20"
        >
        <TextView
            android:layout_width="@dimen/scaled_w_dp_200"
            android:layout_height="wrap_content"
            android:text="修改采购订单数"
            android:textSize="@dimen/scaled_t_dp_24"
            >
        </TextView>
        <EditText
            android:id="@+id/ed_procure_num"
            android:layout_width="@dimen/scaled_w_dp_200"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/scaled_w_dp_20"
            android:text=""
            android:textSize="@dimen/scaled_t_sp_24"
            android:inputType="number"
            ></EditText>
    </LinearLayout>

</LinearLayout>