<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="@dimen/scaled_h_dp_10"
        android:paddingLeft="@dimen/scaled_h_dp_10"
        android:paddingRight="@dimen/scaled_h_dp_10"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/scaled_t_sp_16"
            android:text="品牌代号">
        </TextView>

        <TextView
            android:id="@+id/tv_domainname"
            android:textSize="@dimen/scaled_t_sp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/scaled_h_dp_20"></TextView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="@dimen/scaled_h_dp_10"
        android:layout_gravity="center_horizontal"
        android:paddingLeft="@dimen/scaled_h_dp_10"
        android:paddingRight="@dimen/scaled_h_dp_10"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="修改代号"
            android:textSize="@dimen/scaled_t_sp_16">
        </TextView>

        <EditText
            android:id="@+id/ed_domainname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入要修改的代号"
            android:layout_marginLeft="@dimen/scaled_h_dp_20"
            android:textSize="@dimen/scaled_t_sp_16"
            >
            <requestFocus/>
        </EditText>
    </LinearLayout>

</LinearLayout>