<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="HardcodedText" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal" >

        <TextView
            android:id="@+id/txt_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:padding="@dimen/scaled_w_dp_2"
            android:text=""
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="@dimen/scaled_t_dp_28" />
        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="fill_parent"
            android:background="#AEAEAE" />

        <TextView
            android:id="@+id/txt_list1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:padding="@dimen/scaled_w_dp_2"
            android:text=""
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="@dimen/scaled_t_dp_28" />

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="fill_parent"
            android:background="#AEAEAE" />


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:padding="@dimen/scaled_w_dp_2"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/txt_refractive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:padding="@dimen/scaled_w_dp_2"
                android:text=""
                android:gravity="center"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="@dimen/scaled_t_dp_24" />

            <TextView
                android:id="@+id/txt_remark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="@dimen/scaled_t_dp_24"
                android:gravity="center"
                />
        </LinearLayout>

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="fill_parent"
            android:background="#AEAEAE" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:padding="@dimen/scaled_w_dp_2"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/txt_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:gravity="center"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="@dimen/scaled_t_dp_24" />
            <TextView
                android:id="@+id/txt_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="@dimen/scaled_t_dp_24"
                android:gravity="center"
                />
        </LinearLayout>

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="fill_parent"
            android:background="#AEAEAE" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:padding="@dimen/scaled_w_dp_2"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/txt_list2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:gravity="center"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="@dimen/scaled_t_dp_24" />

            <TextView
                android:id="@+id/txt_list3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="@dimen/scaled_t_dp_24"
                android:gravity="center"
                />
        </LinearLayout>

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="fill_parent"
            android:background="#AEAEAE" />

        <TextView
            android:id="@+id/txt_list4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:padding="@dimen/scaled_o_dp_5"
            android:text=""
            android:gravity="center"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="@dimen/scaled_t_dp_28" />


<!--        <View-->
<!--            android:layout_width="1dp"-->
<!--            android:layout_height="fill_parent"-->
<!--            android:background="#AEAEAE" />-->

<!--        <TextView-->
<!--            android:id="@+id/txt_code"-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_weight="0.8"-->
<!--            android:padding="10dp"-->
<!--            android:text="条码"-->
<!--            android:textAppearance="?android:attr/textAppearanceLarge"-->
<!--            android:textSize="30dp" />-->


    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/scaled_w_dp_1"
        android:background="#AEAEAE" />

</LinearLayout>