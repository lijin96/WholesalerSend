<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/scaled_w_dp_10" >

            <RelativeLayout
                android:layout_width="@dimen/scaled_w_dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:layout_marginTop="@dimen/scaled_h_dp_8"
                android:layout_marginBottom="@dimen/scaled_h_dp_8" >

                <TextView
                    android:id="@+id/tv_goodsid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/scaled_h_dp_5"
                    android:paddingLeft="@dimen/scaled_w_dp_5"
                    android:text="产品ID"
                    android:textSize="@dimen/scaled_t_dp_28" />

                <TextView
                    android:id="@+id/tv_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_goodsid"
                    android:text="（"
                    android:textSize="@dimen/scaled_t_dp_24" />

                <TextView
                    android:id="@+id/tv_prodtype"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_goodsid"
                    android:layout_toRightOf="@id/tv_left"
                    android:text="品类"
                    android:textSize="@dimen/scaled_t_dp_24" />

                <TextView
                    android:id="@+id/tv_rfght"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_goodsid"
                    android:layout_toRightOf="@id/tv_prodtype"
                    android:text="）"
                    android:textSize="@dimen/scaled_t_dp_24" />
                <TextView
                    android:id="@+id/tv_rfghtbrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_goodsid"
                    android:layout_toRightOf="@id/tv_rfght"
                    android:text="-（"
                    android:textSize="@dimen/scaled_t_dp_24" />
                <TextView
                    android:id="@+id/tv_brandname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_goodsid"
                    android:layout_toRightOf="@id/tv_rfghtbrand"
                    android:text="品牌"
                    android:textSize="@dimen/scaled_t_dp_24" />
                <TextView
                    android:id="@+id/tv_leftbrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_goodsid"
                    android:layout_toRightOf="@id/tv_brandname"
                    android:text="）"
                    android:textSize="@dimen/scaled_t_dp_24" />

            </RelativeLayout>

            <View
                android:layout_width="@dimen/scaled_w_dp_1"
                android:layout_height="match_parent"
                android:background="#AEAEAE" />

            <TextView
                android:id="@+id/tv_product_descr"
                android:layout_width="@dimen/scaled_w_dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:padding="@dimen/scaled_o_dp_5"
                android:text="产品描述"
                android:textSize="@dimen/scaled_t_dp_28" />
            <View
                android:layout_width="@dimen/scaled_w_dp_1"
                android:layout_height="match_parent"
                android:background="#AEAEAE" />

            <TextView
                android:id="@+id/tv_refractivity"
                android:layout_width="@dimen/scaled_w_dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:padding="@dimen/scaled_o_dp_5"
                android:text="折射率"
                android:textSize="@dimen/scaled_t_dp_28" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/scaled_h_dp_1"
        android:background="#AEAEAE" />

</LinearLayout>