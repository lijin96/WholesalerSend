<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="HardcodedText,dpUsage,InefficientWeight,UselessLeaf" >

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:gravity="left"
        android:paddingLeft="@dimen/scaled_w_dp_10"
        android:text="【有单有入库代销零售发货】"
        android:textColor="@color/white"
        android:textSize="@dimen/scaled_t_dp_30" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/titlebar_back"
        android:gravity="center_vertical"
        android:orientation="horizontal" >

        <RelativeLayout
            android:id="@+id/relayout_left"
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingBottom="@dimen/scaled_h_dp_5"
            android:paddingTop="@dimen/scaled_h_dp_5" >

            <RelativeLayout
                android:id="@+id/relayout_source_billno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tv_source_billno_str"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/scaled_w_dp_10"
                    android:text="配货单："
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />

                <TextView
                    android:id="@+id/tv_source_billno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@id/tv_source_billno_str"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/relayout_billno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/relayout_source_billno"
                android:layout_marginTop="@dimen/scaled_h_dp_5">

                <TextView
                    android:id="@+id/tv_billno_str"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/scaled_w_dp_10"
                    android:text="总公司发货单："
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />

                <TextView
                    android:id="@+id/tv_billno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@id/tv_billno_str"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/relayout_billno"
                android:layout_marginTop="@dimen/scaled_h_dp_5">

                <TextView
                    android:id="@+id/tv_agentbillno_str"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/scaled_w_dp_10"
                    android:text="代理商发货单："
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />

                <TextView
                    android:id="@+id/tv_agent_billno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@id/tv_agentbillno_str"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />
            </RelativeLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relayout_right"
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingBottom="@dimen/scaled_h_dp_5"
            android:paddingTop="@dimen/scaled_h_dp_5" >

            <RelativeLayout
                android:id="@+id/relayout_company"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible" >

                <TextView
                    android:id="@+id/tv_company_str"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/scaled_w_dp_10"
                    android:text="代理商："
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />

                <TextView
                    android:id="@+id/tv_company_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@id/tv_company_str"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/relayout_retail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/relayout_company">

                <TextView
                    android:id="@+id/tv_retail_str"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/scaled_w_dp_10"
                    android:text="零售商："
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />

                <TextView
                    android:id="@+id/tv_retail_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@id/tv_retail_str"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/relayout_stock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/relayout_retail">

                <TextView
                    android:id="@+id/tv_stock_str"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/scaled_w_dp_10"
                    android:text="仓    库："
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />

                <TextView
                    android:id="@+id/tv_stock_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@id/tv_stock_str"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_30" />
            </RelativeLayout>

        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cornflowerblue"
        android:orientation="horizontal" >

        <TextView
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:gravity="center"
            android:paddingBottom="@dimen/scaled_h_dp_15"
            android:paddingTop="@dimen/scaled_h_dp_15"
            android:text="条\t\t码"
            android:textColor="@color/white"
            android:textSize="@dimen/scaled_t_dp_30" />

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="fill_parent"
            android:layout_marginLeft="@dimen/scaled_w_dp_2"
            android:layout_marginRight="@dimen/scaled_w_dp_2"
            android:background="#696969" />

        <LinearLayout
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="match_parent"
            android:layout_weight="2.5"
            android:gravity="center_vertical"
            android:orientation="horizontal" >

            <EditText
                android:id="@+id/et_barcode"
                android:layout_width="@dimen/scaled_w_dp_0"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/scaled_w_dp_5"
                android:layout_marginRight="@dimen/scaled_w_dp_5"
                android:layout_weight="1.5"
                android:ems="18"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:inputType="text"
                android:textSize="@dimen/scaled_t_dp_30" >

                <requestFocus />
            </EditText>

            <Spinner
                android:id="@+id/spinner_type"
                android:layout_width="140dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:spinnerMode="dialog"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_revoke"
                android:layout_width="@dimen/scaled_w_dp_0"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/scaled_w_dp_10"
                android:layout_marginRight="@dimen/scaled_w_dp_10"
                android:layout_weight="0.5"
                android:text="撤销"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#A2A2A2"
        android:gravity="center"
        android:orientation="horizontal" >

        <LinearLayout
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/scaled_h_dp_3"
            android:layout_marginTop="@dimen/scaled_h_dp_3"
            android:layout_weight="0.5"
            android:orientation="vertical" >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="@dimen/scaled_h_dp_10"
                android:paddingTop="@dimen/scaled_h_dp_10"
                android:text="当前扫描条码 "
                android:textSize="@dimen/scaled_t_dp_30"
               />
        </LinearLayout>

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/scaled_w_dp_2"
            android:layout_marginRight="@dimen/scaled_w_dp_2"
            android:background="#696969" />

        <LinearLayout
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1.9"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/tv_show_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/scaled_w_dp_5"
                android:text=""
                android:textSize="@dimen/scaled_t_dp_30" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:gravity="center"
            android:orientation="horizontal" >

            <Button
                android:id="@+id/btn_chooseretail"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/scaled_h_dp_80"
                android:layout_marginRight="@dimen/scaled_w_dp_20"
                android:text="选择零售商"
                android:visibility="gone"
                android:textSize="@dimen/scaled_t_dp_28" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/scaled_w_dp_1"
        android:background="#696969" />

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="#A2A2A2"
        android:gravity="center_vertical"
        android:orientation="horizontal" >

        <LinearLayout
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:orientation="vertical"
            android:paddingBottom="@dimen/scaled_h_dp_15"
            android:paddingTop="@dimen/scaled_h_dp_15" >

            <TextView
                android:id="@+id/TextView06"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="型号色号 "
                android:textSize="@dimen/scaled_t_dp_30" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="center">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="(产品ID)"
                    android:textSize="@dimen/scaled_t_dp_28" />
                <TextView
                    android:id="@+id/tv_instock_batch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="批号"
                    android:textSize="@dimen/scaled_t_dp_26"
                    android:visibility="gone"
                    android:layout_marginLeft="@dimen/scaled_w_dp_10"></TextView>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/scaled_w_dp_2"
            android:layout_marginRight="@dimen/scaled_w_dp_2"
            android:background="#696969" />

        <LinearLayout
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1.9"
            android:orientation="vertical"
            android:paddingBottom="@dimen/scaled_h_dp_15"
            android:paddingTop="@dimen/scaled_h_dp_15" >

            <TextView
                android:id="@+id/tv_model_colors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/scaled_w_dp_5"
                android:text=""
                android:textSize="@dimen/scaled_t_dp_30" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingLeft="@dimen/scaled_w_dp_10"
                >
                <TextView
                    android:id="@+id/tv_goodsid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="@dimen/scaled_t_dp_28" />

                <TextView
                    android:id="@+id/tv_text_batch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="@dimen/scaled_t_dp_26"
                    android:visibility="gone"
                    android:layout_marginLeft="@dimen/scaled_w_dp_30"></TextView>
            </LinearLayout>


        </LinearLayout>

        <View
            android:layout_width="@dimen/scaled_w_dp_1"
            android:layout_height="match_parent"
            android:background="#696969" />

        <LinearLayout
            android:layout_width="@dimen/scaled_w_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:gravity="center"
            android:orientation="horizontal" >

            <Button
                android:id="@+id/btn_select_goodsid"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/scaled_h_dp_80"
                android:layout_marginRight="@dimen/scaled_w_dp_20"
                android:text="查看"
                android:textSize="@dimen/scaled_t_dp_28" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="2.88"
        android:orientation="vertical" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/scaled_h_dp_80"
            android:gravity="center_vertical"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/TextView07"
                android:layout_width="@dimen/scaled_w_dp_0"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:background="#D7D7D7"
                android:gravity="center"
                android:text="此型号累计"
                android:textSize="@dimen/show_title_size" />

            <View
                android:layout_width="@dimen/scaled_w_dp_2"
                android:layout_height="fill_parent"
                android:background="#AEAEAE" />

            <TextView
                android:id="@+id/TextView09"
                android:layout_width="@dimen/scaled_w_dp_0"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:background="#D7D7D7"
                android:gravity="center"
                android:text="合\t计"
                android:textSize="@dimen/show_title_size" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/scaled_w_dp_1"
            android:background="#AEAEAE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/tv_curqty"
                android:layout_width="@dimen/scaled_w_dp_0"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/darkgreen"
                android:textSize="@dimen/scaled_t_dp_60" />

            <View
                android:layout_width="@dimen/scaled_w_dp_2"
                android:layout_height="fill_parent"
                android:background="#AEAEAE" />

            <TextView
                android:id="@+id/tv_totalqty"
                android:layout_width="@dimen/scaled_w_dp_0"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0"
                android:textSize="@dimen/scaled_t_dp_60" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/LinearLayout01"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/titlebar_back"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/scaled_h_dp_10"
        android:paddingTop="@dimen/scaled_h_dp_10" >


        <Button
            android:id="@+id/btn_list"
            android:layout_width="@dimen/scaled_w_dp_250"
            android:layout_height="@dimen/scaled_h_dp_80"
            android:text="明细"
            android:textSize="@dimen/show_title_size" />

        <Button
            android:id="@+id/btn_print"
            android:layout_width="@dimen/scaled_w_dp_250"
            android:layout_height="@dimen/scaled_h_dp_80"
            android:layout_marginLeft="@dimen/scaled_w_dp_30"
            android:text="打印"
            android:textSize="@dimen/show_title_size" />

        <Button
            android:id="@+id/btn_exit"
            android:layout_width="@dimen/scaled_w_dp_250"
            android:layout_height="@dimen/scaled_h_dp_80"
            android:layout_marginLeft="@dimen/scaled_w_dp_30"
            android:text="完成"
            android:textSize="@dimen/show_title_size" />
    </LinearLayout>

</LinearLayout>