<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/RelativeLayout1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="Deprecated,ContentDescription,HardcodedText,ObsoleteLayoutParam,UnknownIdInLayout,UnknownId">

    <ImageView
        android:id="@+id/titlebottomimageView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_title_height"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_x="@dimen/scaled_o_dp_0"
        android:layout_y="@dimen/scaled_o_dp_neg2"
        android:scaleType="fitXY"
        android:src="@drawable/titlebackground" />

    <Button
        android:id="@+id/titlebotom_btn1"
        android:layout_width="@dimen/app_titlebottom_width"
        android:layout_height="@dimen/app_titleexit_height"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_centerInParent="true"
        android:layout_marginLeft="@dimen/scaled_w_dp_15"
        android:layout_marginTop="@dimen/scaled_h_dp_10"
        android:layout_x="@dimen/scaled_o_dp_10"
        android:layout_y="@dimen/scaled_o_dp_4"
        android:background="@drawable/button_background"
        android:scaleType="fitXY"
        android:text="测试打印"
        android:textColor="@color/white"
        android:textSize="@dimen/login_font_size" />

    <Button
        android:id="@+id/titlebotom_btn2"
        android:layout_width="@dimen/app_titlebottom_width"
        android:layout_height="@dimen/app_titleexit_height"
        android:layout_alignBottom="@+id/bottombtn1"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="@dimen/scaled_h_dp_10"
        android:layout_marginRight="@dimen/scaled_w_dp_15"
        android:background="@drawable/button_background"
        android:text="清空菜单"
        android:textColor="@color/white"
        android:textSize="@dimen/login_font_size" />

</RelativeLayout>