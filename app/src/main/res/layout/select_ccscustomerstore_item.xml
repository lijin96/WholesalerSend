<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/LinearLayout1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="blocksDescendants"
    android:focusable="false"
    android:orientation="vertical"
    tools:ignore="DisableBaselineAlignment,HardcodedText,ScrollViewSize,InefficientWeight,Uselesdparent,NestedWeights,ObsoleteLayoutParam,Deprecated" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/bottom_tab_padding_up"
        >

        <RelativeLayout
            android:layout_width="@dimen/scaled_h_dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="@dimen/scaled_o_dp_5">

            <TextView
                android:id="@+id/customer_Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:text="CCS客户名称"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:paddingTop="3dp"/>

            <TextView
                android:id="@+id/tv_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/customer_Name"
                android:text="（"
                android:textSize="14dp" />

            <TextView
                android:id="@+id/customer_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/customer_Name"
                android:layout_toRightOf="@id/tv_left"
                android:text="代号"
                android:textSize="14dp"
                android:paddingBottom="3dp"/>

            <TextView
                android:id="@+id/tv_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/customer_Name"
                android:layout_toRightOf="@id/customer_id"
                android:text="）"
                android:textSize="14dp" />
        </RelativeLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#AEAEAE" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:paddingLeft="5dp" >

            <TextView
                android:id="@+id/customer_Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="联系人"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="16dp"
                android:paddingLeft="3dp" />

            <TextView
                android:id="@+id/customer_tel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/customer_Link"
                android:text="（"
                android:textSize="14dp" />

            <TextView
                android:id="@+id/customer_Tel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/customer_Link"
                android:layout_toRightOf="@+id/customer_tel"
                android:text="联系电话"
                android:textSize="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/customer_Link"
                android:layout_toRightOf="@+id/customer_Tel"
                android:text="）"
                android:textSize="14dp" />
        </RelativeLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#AEAEAE" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:paddingLeft="5dp"
            >

            <TextView
                android:id="@+id/corpaddr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:paddingLeft="5dp"
                android:text="公司地址"
                android:textSize="16dp"
                />
        </RelativeLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#AEAEAE" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#AEAEAE" />

</LinearLayout>