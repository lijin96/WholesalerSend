<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:ignore="TextFields,HardcodedText,InefficientWeight,Uselesdparent" >

    <RelativeLayout
        android:id="@+id/LinearLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/titlebar_back"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/scaled_o_dp_10" >

        <LinearLayout
            android:id="@+id/lin_company_d1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/TextView02"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingLeft="@dimen/scaled_w_dp_5"
                android:text="分销店选择"
                android:textColor="@color/white"
                android:textSize="@dimen/scaled_t_dp_30" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" >

                <TextView
                    android:id="@+id/tv_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/scaled_w_dp_2"
                    android:text="（共 0 条）"
                    android:textColor="@color/white"
                    android:textSize="@dimen/scaled_t_dp_28" />

                <TextView
                    android:id="@+id/company_store_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="找不到资料？"
                    android:textColor="@color/white"
                    android:visibility="gone"
                    android:textSize="@dimen/scaled_t_dp_28" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_customer_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/scaled_w_dp_60"
            android:layout_toRightOf="@+id/lin_company_d1"
            android:text="点击扫码\n选择客户"
            android:textSize="@dimen/scaled_t_sp_24"
            android:textColor="@color/white"
            android:visibility="gone"
             />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="@dimen/scaled_w_dp_350"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/scaled_w_dp_10"
            android:layout_toLeftOf="@+id/btn_search"
            android:hint="输入条件点击确定查找"
            android:imeOptions="flagNoExtractUi"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_search"
            android:layout_width="@dimen/scaled_w_dp_100"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/scaled_w_dp_10"
            android:text="确定" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/burlywood"
        android:gravity="left" >

        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/select_distributor_fenxiao_item" />
    </LinearLayout>

    <ListView
        android:id="@+id/elistview_distributor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="#AEAEAE"
        android:dividerHeight="@dimen/scaled_o_dp_0_1" >
    </ListView>

</LinearLayout>